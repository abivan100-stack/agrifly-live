# Copy to .env and fill in. .env is gitignored - never commit it.

# Blynk Cloud: the device Auth Token (Blynk console -> device -> Device Info). Paste it here yourself.
BLYNK_TOKEN=
BLYNK_SERVER=blr1.blynk.cloud
# How often to read Blynk while a dashboard shows Blynk Cloud (ms).
BLYNK_POLL_MS=2000

# Local Wi-Fi: leave ESP_HOST empty to use the IP the ESP32 publishes on Blynk V10 (then agrifly.local).
# Set it to override, e.g. ESP_HOST=192.168.1.25, or ESP_HOST=localhost:8080 for npm run simulate.
ESP_HOST=
# How often to read the ESP32 while a dashboard shows Local Wi-Fi (ms).
LOCAL_POLL_MS=1000

PORT=3000
