# Copy to .env and fill in. .env is gitignored - never commit it.

# Blynk Cloud: the device Auth Token (Blynk console -> device -> Device Info). Paste it here yourself.
BLYNK_TOKEN=
BLYNK_SERVER=blr1.blynk.cloud
# How often to read Blynk while a dashboard is open (ms). Polling stops when nobody is watching.
BLYNK_POLL_MS=3000

# Local Wi-Fi mode: must match LOCAL_TOKEN in firmware/agrifly_esp32/secrets.h
LOCAL_TOKEN=change-me

PORT=3000
